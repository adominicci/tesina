{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tesina",
  "version": "0.1.23",
  "identifier": "app.tesina.desktop",
  "build": {
    "beforeDevCommand": "deno task vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "deno task vite:build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Tesina",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": {
        "base-uri": ["'none'"],
        "connect-src": ["ipc:", "http://ipc.localhost", "blob:"],
        "default-src": ["'self'"],
        "font-src": ["'self'", "data:"],
        "form-action": ["'none'"],
        "frame-src": ["'none'"],
        "img-src": ["'self'", "blob:", "data:"],
        "object-src": ["'none'"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'", "blob:"]
      },
      "devCsp": {
        "base-uri": ["'none'"],
        "connect-src": [
          "'self'",
          "ipc:",
          "http://ipc.localhost",
          "blob:",
          "ws:"
        ],
        "default-src": ["'self'"],
        "font-src": ["'self'", "data:"],
        "form-action": ["'none'"],
        "frame-src": ["'none'"],
        "img-src": ["'self'", "blob:", "data:"],
        "object-src": ["'none'"],
        "script-src": ["'self'"],
        "style-src": ["'self'", "'unsafe-inline'", "blob:"]
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/adominicci/tesina/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5RThCNjkzQTQyNzM0MQpSV1JCYzBJNmFZdWVBM0JacStMZTdINUlkUFpsNk5IMUM1R2xVdERRTWJWNk5RTlcvZ04yNEpvOAo=",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "resources": {
      "resources/Inter-OFL-1.1.txt": "Inter-OFL-1.1.txt"
    },
    "targets": ["app", "dmg", "msi", "nsis", "appimage", "deb"],
    "macOS": {
      "signingIdentity": "-"
    },
    "category": "Productivity",
    "copyright": "© 2026 Andres Dominicci and Tesina contributors — MIT License",
    "shortDescription": "Ensayos académicos con formato APA 7 automático / APA 7 academic writing, formatted for you",
    "longDescription": "Tesina es un procesador de textos académicos open source: portada, márgenes, interlineado, citas en el texto y lista de referencias en APA 7, en español o en inglés. Tú escribes; del formato se encarga Tesina. / Tesina is an open-source academic word processor: title page, margins, spacing, in-text citations, and the APA 7 reference list, in Spanish or English. You write; Tesina does the formatting.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
