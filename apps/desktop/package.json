{
  "name": "@tesina/desktop",
  "version": "0.1.24",
  "description": "Tesina desktop app (Tauri 2 + Svelte 5)",
  "private": true,
  "type": "module",
  "scripts": {
    "vite:dev": "vite dev",
    "vite:build": "vite build",
    "vite:preview": "vite preview",
    "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "app:check": "deno task paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "app:check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@noble/hashes": "1.8.0",
    "@retorquere/bibtex-parser": "^10.0.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-fs": "^2",
    "@tauri-apps/plugin-http": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@tesina/docx-export": "*",
    "@tesina/engine": "*",
    "@tiptap/core": "3.31.3",
    "@tiptap/extension-table": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "dompurify": "3.4.13",
    "fflate": "^0.8.2",
    "marked": "18.0.9",
    "pagedjs": "^0.4.3",
    "temml": "^0.12.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.4.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "jsdom": "^26.0.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "@tauri-apps/cli": "^2"
  }
}
